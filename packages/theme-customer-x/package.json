{
  "name": "@globallogicuki/backstage-theme-customer-x",
  "version": "0.1.0",
  "description": "CustomerX theme for Backstage: brand tokens, the unified MUI/BUI theme, and the bespoke sidebar, landing and sign-in surfaces",
  "private": true,
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "restricted",
    "main": "dist/index.cjs.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "web-library"
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "tokens": "esbuild scripts/export-tokens.ts --bundle --platform=node --format=esm --log-level=warning --outfile=dist-tokens/.export.mjs && node dist-tokens/.export.mjs"
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.10.0",
    "@backstage/core-components": "^0.18.13",
    "@backstage/core-plugin-api": "^1.12.9",
    "@backstage/frontend-plugin-api": "^0.18.0",
    "@backstage/plugin-app-react": "^0.2.6",
    "@backstage/plugin-catalog-react": "^3.2.1",
    "@backstage/plugin-home": "^0.9.9",
    "@backstage/plugin-search": "^1.7.7",
    "@backstage/plugin-search-common": "^1.2.24",
    "@backstage/plugin-search-react": "^1.11.7",
    "@backstage/plugin-techdocs-react": "^1.3.14",
    "@backstage/theme": "^0.7.3",
    "@material-ui/core": "^4.12.2",
    "@material-ui/icons": "^4.9.1",
    "react-use": "^17.2.4"
  },
  "peerDependencies": {
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.5",
    "esbuild": "0.28.2",
    "react": "^18.0.2",
    "react-router-dom": "^6.30.2"
  },
  "files": [
    "dist",
    "dist-tokens"
  ]
}
